# How long browsers may keep each kind of file (Cloudflare reads this file; on another host, the same rules go in
# its server settings: see README "Hosting"). Files whose names change with their contents (the build's /_astro/,
# the fonts) are kept for a year; photos and films for a month; the pages themselves are always checked afresh.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/media/*
  Cache-Control: public, max-age=2592000
/video/*
  Cache-Control: public, max-age=2592000
/img/*
  Cache-Control: public, max-age=2592000
/og/*
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
# Every response: https only from now on, never inside another site's frame
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
