---
// "Request a call" and "Ask a question" (styles in styles/ask.css; its controls are the booking window's,
// styles/apply.css). The club's own number is never shown on the site: a visitor leaves theirs, and a manager
// calls back or answers the question. One dialog for the whole site (Base.astro), opened by any button with
// data-contact="callback" or data-contact="question"; two plates at the top go from one to the other. It sends to
// /api/booking like the booking (the managers' Telegram); if that fails, everything typed stays to send again, and
// the same words are ready to send in WhatsApp. While it is open the page behind is held still, as under the
// booking. Personal data is never put in the URL.
import { type Lang, ui } from '../data/i18n';
import { site } from '../data/site';
import { keepShort } from '../data/format';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const f = ui[lang].form;
// The consent's sentence is i18n's; only the policy's own name in it is the link, so a tap on the rest ticks the box
// (were the sentence ever reworded without that name, its last two words would be the link). «18 лет» stays together.
const [, consentA, consentLink, consentB] =
  f.consent.match(/^(.*?)(политику конфиденциальности|the privacy policy)(.*)$/) ?? f.consent.match(/^(.*\s)(\S+\s+\S+)()$/) ?? ['', '', f.consent, ''];
const unit = (t: string) => t.replace(/(\d) (?=\p{L})/gu, '$1 ');
const L = ru
  ? {
      callback: 'Заказать звонок', question: 'Задать вопрос',
      hCallback: 'Перезвоним вам', hQuestion: 'Задайте вопрос',
      leadCallback: 'Оставьте имя и номер: менеджер клуба позвонит сам.',
      leadQuestion: 'Напишите вопрос и выберите, где ответить.',
      text: 'Вопрос', via: 'Как ответить', call: 'Звонок',
      sendCallback: 'Заказать звонок', sendQuestion: 'Отправить вопрос',
      doneCallback: 'Спасибо. Менеджер скоро позвонит.', doneQuestion: 'Спасибо. Менеджер скоро ответит.',
      doneText: 'Номер видят только менеджеры клуба. Всё остальное между нами.', ok: 'Хорошо',
      failTitle: 'Не получилось отправить', failText: 'Всё, что вы ввели, сохранено: попробуйте ещё раз. Или напишите нам в WhatsApp, текст уже в сообщении.', retry: 'Отправить ещё раз',
      close: 'Закрыть',
      // (the booking's own two messages, and one for a question left empty)
      needContact: 'Укажите имя и телефон.', needQuestion: 'Напишите ваш вопрос.', needConsent: 'Отметьте согласие на обработку данных.',
    }
  : {
      callback: 'Request a call', question: 'Ask a question',
      hCallback: 'We’ll call you', hQuestion: 'Your question',
      leadCallback: 'Leave your name and number, and a club manager will call you.',
      leadQuestion: 'Write your question and choose where we answer.',
      text: 'Your question', via: 'How should we answer', call: 'Phone call',
      sendCallback: 'Request a call', sendQuestion: 'Send your question',
      doneCallback: 'Thank you. A manager will call you shortly.', doneQuestion: 'Thank you. A manager will answer shortly.',
      doneText: 'Only the club’s managers see your number. The rest stays between us.', ok: 'All right',
      failTitle: 'We couldn’t send it', failText: 'Nothing you typed is lost: try again. Or message us on WhatsApp, your words are already in the message.', retry: 'Try again',
      close: 'Close',
      needContact: 'Please enter your name and phone.', needQuestion: 'Please write your question.', needConsent: 'Please tick the consent box.',
    };
// where to answer a question: the booking's three plates
const vias = ['WhatsApp', 'Telegram', L.call];
const script = { callback: L.callback, question: L.question, call: L.call, sending: f.sending, needContact: L.needContact, needQuestion: L.needQuestion, needConsent: L.needConsent };
---
<dialog class="ask" id="ask" aria-labelledby="ask-h" data-lenis-prevent data-wa={site.whatsapp} data-l={JSON.stringify(script)}>
  <form class="ask-box" method="dialog" novalidate data-mode="callback" data-state="form">
    <header class="ask-top">
      <div class="ask-switch" role="group" aria-label={ru ? 'Что вы хотите' : 'What you’d like'}>
        <button type="button" data-mode="callback" aria-pressed="true">{L.callback}</button>
        <button type="button" data-mode="question" aria-pressed="false">{L.question}</button>
      </div>
      <button class="ask-x" type="button" data-ask-close aria-label={L.close}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </header>

    <div class="ask-body">
      <div class="ask-form">
        <div class="ask-head">
          <h2 class="ask-h" id="ask-h" tabindex="-1"><span data-only="callback">{L.hCallback}</span><span data-only="question" hidden>{L.hQuestion}</span></h2>
          <p class="ask-lead"><span data-only="callback" set:html={keepShort(L.leadCallback, lang)} /><span data-only="question" hidden set:html={keepShort(L.leadQuestion, lang)} /></p>
        </div>
        <div class="ask-fields">
          <div class="field"><label for="ask-name">{f.name}</label><input id="ask-name" name="name" autocomplete="name" required /></div>
          <div class="field"><label for="ask-phone">{f.phone}</label><input id="ask-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required /></div>
          <div class="field full" data-only="question" hidden><label for="ask-text">{L.text}</label><textarea id="ask-text" name="question" rows="3"></textarea></div>
        </div>
        <div class="apl-via" role="radiogroup" aria-labelledby="ask-via-l" data-only="question" hidden>
          <p class="apl-via-l" id="ask-via-l">{L.via}</p>
          <div class="apl-pills">
            {vias.map((v, i) => (
              <label class="apl-pill"><input type="radio" name="messenger" value={v} checked={i === 0} /><span>{v}</span></label>
            ))}
          </div>
        </div>
        <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <label class="consent"><input type="checkbox" name="consent" required /><span>{unit(consentA)}<a href={`/${lang}/privacy/`} target="_blank" rel="noopener">{consentLink}</a>{consentB}</span></label>
      </div>

      <!-- sent -->
      <div class="ask-done apl-end" role="status" hidden>
        <span class="apl-mark" aria-hidden="true"></span>
        <p class="ask-h" tabindex="-1"><span data-only="callback">{L.doneCallback}</span><span data-only="question" hidden>{L.doneQuestion}</span></p>
        <p class="ask-lead" set:html={keepShort(L.doneText, lang)} />
        <div class="btns"><button class="btn btn-crimson" type="button" data-ask-close>{L.ok}</button></div>
      </div>

      <!-- not sent: the same words again, or WhatsApp with them in the message -->
      <div class="ask-fail apl-end" role="alert" hidden>
        <p class="ask-h" tabindex="-1">{L.failTitle}</p>
        <p class="ask-lead" set:html={keepShort(L.failText, lang)} />
        <div class="btns">
          <button class="btn btn-crimson" type="button" data-ask-retry>{L.retry}</button>
          <a class="btn btn-line" data-ask-wa href={site.whatsapp} target="_blank" rel="noopener">{f.sendWa}</a>
          <a class="btn btn-line" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
        </div>
      </div>
    </div>

    <footer class="ask-foot">
      <p class="apl-err" id="ask-err" role="alert" hidden></p>
      <button class="btn btn-crimson ask-send" type="submit"><span data-only="callback">{L.sendCallback}</span><span data-only="question" hidden>{L.sendQuestion}</span></button>
    </footer>
  </form>
</dialog>

<script>
  import { track } from '../scripts/track';

  const dlg = document.querySelector<HTMLDialogElement>('dialog#ask');
  if (dlg) ask(dlg);

  function ask(dlg: HTMLDialogElement) {
    type Mode = 'callback' | 'question';
    type State = 'form' | 'done' | 'fail';
    const root = document.documentElement;
    const form = dlg.querySelector<HTMLFormElement>('form')!;
    const L = JSON.parse(dlg.dataset.l || '{}') as Record<string, string>;
    const ru = root.lang === 'ru';
    const err = form.querySelector<HTMLElement>('.apl-err')!;
    const top = form.querySelector<HTMLElement>('.ask-switch')!;
    const body = form.querySelector<HTMLElement>('.ask-form')!;
    const done = form.querySelector<HTMLElement>('.ask-done')!;
    const fail = form.querySelector<HTMLElement>('.ask-fail')!;
    const foot = form.querySelector<HTMLElement>('.ask-foot')!;
    const send = form.querySelector<HTMLButtonElement>('.ask-send')!;
    const name = form.querySelector<HTMLInputElement>('input[name="name"]')!;
    const phone = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
    const text = form.querySelector<HTMLTextAreaElement>('textarea[name="question"]')!;
    const consent = form.querySelector<HTMLInputElement>('input[name="consent"]')!;
    type Field = HTMLInputElement | HTMLTextAreaElement;
    let mode: Mode = 'callback';
    let state: State = 'form';
    let opened = 0;

    const say = (msg = '') => { err.textContent = msg; err.hidden = !msg; };
    // What can be wrong, and how each is right: the booking's own check (a name, and a phone of six digits or more),
    // a question on the question's side, the consent. A field that is wrong shows it itself (apply.css: .is-bad, its
    // line in light) and says so to a screen reader; put right, its mark goes, and the message with the last of them.
    const checks: [Field, () => boolean][] = [
      [name, () => Boolean(name.value.trim())],
      [phone, () => phone.value.replace(/\D/g, '').length >= 6],
      [text, () => mode !== 'question' || Boolean(text.value.trim())],
      [consent, () => consent.checked],
    ];
    function mark(el: Field, bad: boolean) {
      el.closest('.field, .consent')?.classList.toggle('is-bad', bad);
      if (bad) { el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', err.id); }
      else { el.removeAttribute('aria-invalid'); el.removeAttribute('aria-describedby'); }
    }
    /** The first of these that is wrong: marked, named at the window's foot, and the cursor in it. */
    function wrong(els: Field[], msg: string) {
      const bad = checks.filter(([el, ok]) => els.includes(el) && !ok()).map(([el]) => el);
      els.forEach((el) => mark(el, bad.includes(el)));
      if (!bad.length) return false;
      say(msg);
      bad[0].focus();
      return true;
    }
    const clean = () => { checks.forEach(([el]) => mark(el, false)); say(); };
    form.addEventListener('input', () => {
      checks.forEach(([el, ok]) => { if (el.hasAttribute('aria-invalid') && ok()) mark(el, false); });
      if (!form.querySelector('[aria-invalid]')) say();
    });

    /** The form, or what took its place: sent, or not sent (then the two ways in and the foot go too). */
    function show(s: State) {
      state = s;
      form.dataset.state = s;
      body.hidden = s !== 'form';
      done.hidden = s !== 'done';
      fail.hidden = s !== 'fail';
      top.hidden = foot.hidden = s !== 'form';
      form.querySelector<HTMLElement>('.ask-body')!.scrollTop = 0;
    }
    const setMode = (m: Mode) => {
      mode = m;
      form.dataset.mode = m;
      form.querySelectorAll<HTMLElement>('[data-only]').forEach((el) => { el.hidden = el.dataset.only !== m; });
      form.querySelectorAll<HTMLButtonElement>('.ask-switch [data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
      clean();
    };
    /** Open it: on the side the button asked for, with what was typed still there (afresh after a request went out,
     *  or failed to). With a mouse the cursor stands in the name at once; under a finger nothing is focused that
     *  would bring the keyboard up over a window not yet seen. */
    const open = (m: Mode) => {
      if (dlg.open) return;
      if (state !== 'form') form.reset();
      show('form');
      setMode(m);
      opened = Date.now();
      root.classList.add('ask-lock');
      if (typeof dlg.showModal === 'function') dlg.showModal();
      else dlg.setAttribute('open', '');
      (matchMedia('(hover: hover) and (pointer: fine)').matches ? name : form.querySelector<HTMLElement>('#ask-h'))?.focus({ preventScroll: true });
      track(m === 'callback' ? 'callback_open' : 'question_open');
    };
    /** Close it: the card and the dark leave together (ask.css: .ask-out), and only then the window closes, so the
     *  page is never cut to. (The timer is for a browser that never says the dark has gone.) */
    function close() {
      if (!dlg.open || dlg.classList.contains('ask-out')) return;
      let closed = false;
      const end = (e?: Event) => {
        if (closed || (e && e.target !== dlg)) return; // (the dark is the window's own; the card's end is not waited for)
        closed = true;
        dlg.removeEventListener('animationend', end);
        dlg.classList.remove('ask-out');
        if (typeof dlg.close === 'function') dlg.close();
        else dlg.removeAttribute('open');
        root.classList.remove('ask-lock');
      };
      dlg.addEventListener('animationend', end);
      dlg.classList.add('ask-out');
      setTimeout(end, 400);
    }
    dlg.addEventListener('close', () => root.classList.remove('ask-lock'));
    // Esc: the same closing as the cross
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

    // any "Request a call" / "Ask a question" button on the page
    document.addEventListener('click', (e) => {
      const b = (e.target as Element | null)?.closest<HTMLElement>('[data-contact]');
      if (!b) return;
      e.preventDefault();
      open(b.dataset.contact === 'question' ? 'question' : 'callback');
    });
    form.querySelectorAll<HTMLButtonElement>('.ask-switch [data-mode]').forEach((b) =>
      b.addEventListener('click', () => setMode(b.dataset.mode as Mode)));
    form.querySelectorAll('[data-ask-close]').forEach((b) => b.addEventListener('click', close));
    // a tap on the dark around the card closes it (one that began there: not a drag that began on the card's words)
    let pressed: EventTarget | null = null;
    dlg.addEventListener('pointerdown', (e) => { pressed = e.target; });
    dlg.addEventListener('click', (e) => { if (e.target === dlg && pressed === dlg) close(); });

    const collect = () => {
      const fd = new FormData(form);
      const v = (k: string) => String(fd.get(k) || '').trim();
      return {
        type: mode,
        typeLabel: mode === 'callback' ? L.callback : L.question,
        name: v('name'),
        phone: v('phone'),
        messenger: mode === 'callback' ? L.call : v('messenger'),
        wishes: mode === 'question' ? v('question') : '',
        website: v('website'),
      };
    };
    const asMessage = (d: ReturnType<typeof collect>) => (mode === 'callback'
      ? [ru ? 'Здравствуйте. Перезвоните мне, пожалуйста.' : 'Hello. Please call me back.', `${d.name}, ${d.phone}`]
      : [ru ? 'Здравствуйте. У меня вопрос:' : 'Hello. I have a question:', d.wishes, `${d.name}, ${d.phone}`]
    ).filter(Boolean).join('\n');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (state !== 'form' || send.disabled) return;
      if (wrong([name, phone], L.needContact) || wrong([text], L.needQuestion) || wrong([consent], L.needConsent)) return;
      say();
      const data = collect();
      const label = send.innerHTML;
      send.disabled = true;
      send.textContent = L.sending || '…';
      try {
        const r = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, elapsed: Date.now() - opened, lang: root.lang, page: location.pathname }),
          signal: typeof AbortSignal.timeout === 'function' ? AbortSignal.timeout(12000) : undefined,
        });
        const res = await r.json().catch(() => ({}));
        if (!(r.ok && res.ok)) throw new Error(res.error || String(r.status));
        track(mode === 'callback' ? 'callback_sent' : 'question_sent');
        show('done');
        done.querySelector<HTMLElement>('.ask-h')?.focus({ preventScroll: true });
      } catch {
        track('contact_failed');
        // hand the same words to WhatsApp, so the visitor doesn't lose what they typed
        const wa = fail.querySelector<HTMLAnchorElement>('[data-ask-wa]');
        if (wa) wa.href = `${dlg.dataset.wa}?text=${encodeURIComponent(asMessage(data))}`;
        show('fail');
        fail.querySelector<HTMLElement>('.ask-h')?.focus({ preventScroll: true });
      } finally {
        send.disabled = false;
        send.innerHTML = label;
      }
    });
    // the same words again: back on the form, everything still filled in, and sent
    fail.querySelector('[data-ask-retry]')?.addEventListener('click', () => {
      show('form');
      if (typeof form.requestSubmit === 'function') form.requestSubmit(); else send.click();
    });
  }
</script>
