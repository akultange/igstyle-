---
// The gallery's full-screen viewer, for the photos and the films. Opened by the 'gx:view' event
// ({ list: 'photos' | 'films', i, from }). Arrows, swipe sideways, Esc, pull down or the close button;
// keyboard focus stays inside while it is open and goes back where it came from. With motion the picture
// flies out of the page into place and back again. With reduced motion a film waits with its own controls:
// it takes the focus, and its keys (space, the arrows) are its own while it has it.
// A photograph stands in the middle of the screen, between the controls; a film's words (its name and a line
// about it) go with it, close under its foot. While a photograph's full file is on its way, the copy the page
// already shows stands in for it.
import { type Lang, tr } from '../data/i18n';
import { galleryPhotos, galleryFilms } from '../data/gallery';
import '../styles/gallery.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
// Russian typesetting: in the line under a film's name a short word stays with the word after it. (The line is set
// as plain text, so a no-break space does it, not format.ts's span.)
const tie = (s: string) => (ru ? s.replace(/(?<=^|\s)(в|во|на|за|до|по|с|со|к|ко|и|а|о|у|не|ни|из|от|для|без|под)\s/gi, '$1\u00a0') : s);
const data = {
  // the photographs carry no words in the viewer either (their alt text stays on the picture for screen readers)
  photos: galleryPhotos.map((p) => ({ src: p.src, thumb: p.thumb, ratio: p.ratio, cap: tr(p.cap, lang), alt: tr(p.alt, lang), bare: true })),
  films: galleryFilms.map((f) => ({
    src: f.src, srcPhone: f.srcPhone, poster: f.poster, posterPhone: f.posterPhone, ratio: f.ratio, ratioPhone: f.ratioPhone,
    cap: f.time ? `${f.time} · ${tr(f.cap, lang)}` : tr(f.cap, lang), alt: tr(f.alt, lang), line: tie(tr(f.alt, lang)),
  })),
};
const label = { photos: ru ? 'Фото на весь экран' : 'Photo, full screen', films: ru ? 'Фильм на весь экран' : 'Film, full screen' };
---
<div class="gxv" id="gxv" role="dialog" aria-modal="true" aria-label={label.photos} data-label-photos={label.photos} data-label-films={label.films} hidden data-lenis-prevent>
  <div class="gxv-veil"></div>
  <div class="gxv-stage"></div>
  <div class="gxv-ui">
    <p class="gxv-n" aria-hidden="true"><b></b><span></span></p>
    <button class="gxv-close" type="button"><span>{ru ? 'Закрыть' : 'Close'}</span><i aria-hidden="true"></i></button>
    <button class="gxv-nav gxv-prev" type="button" aria-label={ru ? 'Предыдущее' : 'Previous'}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 5.5 8 12l6.5 6.5" /></svg>
    </button>
    <button class="gxv-nav gxv-next" type="button" aria-label={ru ? 'Следующее' : 'Next'}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 5.5 16 12l-6.5 6.5" /></svg>
    </button>
    <div class="gxv-cap" aria-live="polite"><p class="gxv-t"></p><p class="gxv-d"></p></div>
  </div>
</div>
<script type="application/json" id="gxv-data" is:inline set:html={JSON.stringify(data)} />

<script>
  import { gsap } from 'gsap';

  type Entry = { src: string; thumb?: string; srcPhone?: string; poster?: string; posterPhone?: string; ratio: string; ratioPhone?: string; cap: string; alt: string; line?: string; bare?: boolean };
  type Kind = 'photos' | 'films';

  const root = document.documentElement;
  const lb = document.getElementById('gxv');
  const raw = document.getElementById('gxv-data');
  if (lb && raw) viewer(lb, JSON.parse(raw.textContent || '{}') as Record<Kind, Entry[]>);

  function viewer(lb: HTMLElement, data: Record<Kind, Entry[]>) {
    const stage = lb.querySelector<HTMLElement>('.gxv-stage')!;
    const veil = lb.querySelector<HTMLElement>('.gxv-veil')!;
    const ui = lb.querySelector<HTMLElement>('.gxv-ui')!;
    const nNow = lb.querySelector<HTMLElement>('.gxv-n b')!;
    const nAll = lb.querySelector<HTMLElement>('.gxv-n span')!;
    const tEl = lb.querySelector<HTMLElement>('.gxv-t')!;
    const dEl = lb.querySelector<HTMLElement>('.gxv-d')!;
    const capEl = lb.querySelector<HTMLElement>('.gxv-cap')!;
    const closeB = lb.querySelector<HTMLButtonElement>('.gxv-close')!;
    const prevB = lb.querySelector<HTMLButtonElement>('.gxv-prev')!;
    const nextB = lb.querySelector<HTMLButtonElement>('.gxv-next')!;
    const phoneQ = matchMedia('(max-width: 899px)');
    // the upright cuts of pictures and films are for phones held upright; a phone on its side (a short, wide
    // screen) shows the picture the full height, with the controls at its sides (landscape.css)
    const uprightQ = matchMedia('(max-width: 899px) and (orientation: portrait)');
    const shortQ = matchMedia('(orientation: landscape) and (max-height: 500px)');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const anim = root.classList.contains('motion') && !reduce;
    const pad2 = (n: number) => String(n).padStart(2, '0');
    let kind: Kind = 'photos';
    let list: Entry[] = [];
    let at = 0, opened = 0;
    let media: HTMLElement | null = null;
    let isOpen = false;
    let lastFocus: HTMLElement | null = null;

    const ratioOf = (e: Entry) => {
      const [a, b] = ((uprightQ.matches && e.ratioPhone) || e.ratio).split('/').map(Number);
      return a / b;
    };
    /** Where an entry stands: the biggest box of its shape that fits between the controls (measured where they
     *  stand: «Закрыть» above; on a phone the arrows and the count below, on a computer the arrows at the sides).
     *  A photograph has no words and takes the middle of the screen. A film's words go with it: they take the room
     *  they need under its foot (measured, so three lines on a narrow phone never run into the film), and the two
     *  are centred together. `cap` is where the words start; null on a phone held sideways, where the picture
     *  takes the full height and the film's name lies over its foot (gallery.css). */
    function fit(e: Entry) {
      const r = ratioOf(e);
      const vw = lb.clientWidth || innerWidth, vh = lb.clientHeight || innerHeight, ph = phoneQ.matches, sh = shortQ.matches;
      let top = 10, bottom = 10, side = Math.max(84, vw * 0.11), gap = 0, words = 0;
      if (!sh) {
        const closeEnd = closeB.offsetTop + closeB.offsetHeight;
        const row = ph ? vh - (prevB.hidden ? vh - 68 : prevB.offsetTop) : 0; // the bottom row, with the margin under it
        side = ph ? 0 : Math.max(114, vw * 0.08);
        if (e.bare) top = bottom = ph ? Math.max(closeEnd, row) + 16 : closeEnd + 26;
        else {
          gap = ph ? 16 : 24;
          words = capEl.offsetHeight;
          top = closeEnd + (ph ? 16 : 26);
          bottom = ph ? row + 20 : 40;
        }
      }
      const room = vh - top - bottom - (words ? words + gap : 0);
      let w = vw - side * 2, h = w / r;
      if (h > room) { h = Math.max(120, room); w = h * r; }
      const y = top + Math.max(0, (room - h) / 2);
      return { left: (vw - w) / 2, top: y, width: w, height: h, cap: sh || !words ? null : y + h + gap };
    }
    /** Put a picture, and the words that go with it, where the entry stands. */
    function seat(el: HTMLElement, e: Entry) {
      const b = fit(e);
      Object.assign(el.style, { left: `${b.left}px`, top: `${b.top}px`, width: `${b.width}px`, height: `${b.height}px` });
      if (b.cap === null) capEl.style.removeProperty('--cap-top');
      else capEl.style.setProperty('--cap-top', `${b.cap.toFixed(1)}px`);
    }
    /** The film on screen, when it has its own controls (reduced motion). */
    const player = () => media?.querySelector<HTMLVideoElement>('video[controls]') ?? null;
    /** The walk is running (the page under the viewer is the 3D room, not the rows). */
    const walking = () => !!document.querySelector('.gxd.is-3d');

    function make(e: Entry) {
      const d = document.createElement('div');
      d.className = 'gxv-media';
      if (kind === 'photos') {
        // the page's own copy of this picture (the one just looked at, so it is here already) stands in, as the
        // box's ground, until the full file has come; a picture the page has not loaded yet gets its small copy
        const small = document.querySelectorAll<HTMLElement>('.gxd-item')[at]?.querySelector('img');
        const standIn = (small?.complete && small.naturalWidth && small.currentSrc) || e.thumb;
        if (standIn) d.style.backgroundImage = `url("${standIn}")`;
        const img = new Image();
        img.decoding = 'async';
        img.src = e.src;
        img.alt = e.alt;
        img.draggable = false;
        if (!img.complete) {
          img.classList.add('wait');
          img.addEventListener('load', () => img.classList.remove('wait'), { once: true });
        }
        d.append(img);
      } else {
        const v = document.createElement('video');
        v.muted = true;
        v.loop = true;
        v.playsInline = true;
        v.setAttribute('playsinline', '');
        v.poster = (uprightQ.matches && e.posterPhone) || e.poster || '';
        v.setAttribute('aria-label', e.alt);
        if (reduce) { v.controls = true; v.tabIndex = 0; v.preload = 'metadata'; } else { v.autoplay = true; v.preload = 'auto'; }
        v.src = (uprightQ.matches && e.srcPhone) || e.src;
        d.append(v);
        if (!reduce) v.play().catch(() => {});
      }
      seat(d, e);
      return d;
    }
    // (the words are set before the picture is made: it is seated by their height)
    function caption() {
      const e = list[at];
      nNow.textContent = pad2(at + 1);
      nAll.textContent = ` / ${pad2(list.length)}`;
      tEl.textContent = e.bare ? '' : e.cap;
      dEl.textContent = e.bare ? '' : e.line ?? e.alt;
      const one = list.length < 2;
      prevB.hidden = one;
      nextB.hidden = one;
    }
    // the neighbours load while you look
    function warm() {
      if (kind !== 'photos') return;
      [1, -1].forEach((d) => { const im = new Image(); im.src = list[(at + d + list.length) % list.length].src; });
    }
    /** The picture on the page that belongs to entry i, if it can be seen right now. */
    function sourceOf(i: number): DOMRect | null {
      const el = kind === 'photos'
        ? document.querySelectorAll<HTMLElement>('.gxd-item')[i]?.querySelector<HTMLElement>('.gxd-ph')
        : document.querySelectorAll<HTMLElement>('.gxf-card')[i]?.querySelector<HTMLElement>('.gxf-media');
      if (!el) return null;
      const item = el.closest<HTMLElement>('.gxd-item, .gxf-card')!;
      const cs = getComputedStyle(item);
      if (cs.display === 'none' || parseFloat(cs.opacity) < 0.3) return null;
      const r = el.getBoundingClientRect();
      if (r.width < 8 || r.bottom < 0 || r.top > innerHeight || r.right < 0 || r.left > innerWidth) return null;
      return r;
    }
    function fly(el: HTMLElement, r: DOMRect, back: boolean, done?: () => void) {
      // measured without any transform (a drag may have moved it): the box the viewer placed it in
      const b = { left: el.offsetLeft, top: el.offsetTop, width: el.offsetWidth, height: el.offsetHeight };
      const at = { x: r.left - b.left, y: r.top - b.top, scaleX: r.width / b.width, scaleY: r.height / b.height };
      if (back) {
        const cur = el.getBoundingClientRect();
        // keep where it is right now while the origin moves to the corner, then fly home
        gsap.set(el, { transformOrigin: '0 0', x: cur.left - b.left, y: cur.top - b.top, scaleX: cur.width / b.width, scaleY: cur.height / b.height });
        gsap.to(el, { ...at, duration: 0.7, ease: 'expo.inOut', onComplete: done });
      } else {
        gsap.set(el, { transformOrigin: '0 0' });
        gsap.fromTo(el, at, { x: 0, y: 0, scaleX: 1, scaleY: 1, duration: 0.85, ease: 'expo.out', onComplete: () => { gsap.set(el, { transformOrigin: '50% 50%' }); done?.(); } });
      }
    }

    function openAt(k: Kind, i: number, from?: Element | null) {
      if (isOpen || !data[k]?.length) return;
      kind = k;
      list = data[k];
      at = opened = Math.max(0, Math.min(list.length - 1, i));
      lastFocus = (from as HTMLElement) || (document.activeElement as HTMLElement);
      isOpen = true;
      lb.setAttribute('aria-label', lb.dataset[k === 'photos' ? 'labelPhotos' : 'labelFilms'] || '');
      lb.hidden = false;
      root.classList.add('gx-lock');
      document.dispatchEvent(new CustomEvent('gx:viewer', { detail: { open: true } }));
      stage.replaceChildren();
      caption();
      media = make(list[at]);
      stage.append(media);
      warm();
      if (anim) {
        const r = sourceOf(at);
        if (r) fly(media, r, false);
        else gsap.fromTo(media, { opacity: 0, scale: 0.96 }, { opacity: 1, scale: 1, duration: 0.6, ease: 'expo.out' });
        gsap.fromTo(veil, { opacity: 0 }, { opacity: 1, duration: 0.5, ease: 'power2.out' });
        gsap.fromTo(ui, { opacity: 0 }, { opacity: 1, duration: 0.5, delay: 0.25, ease: 'power2.out' });
      } else {
        veil.style.opacity = '1';
        ui.style.opacity = '1';
      }
      // a film with its own controls takes the focus, so the keyboard can play it right away
      (player() ?? closeB).focus({ preventScroll: true });
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      const moved = kind === 'photos' && at !== opened;
      const walk = walking();
      const done = () => {
        lb.hidden = true;
        stage.replaceChildren();
        media = null;
        gsap.set([veil, ui], { clearProps: 'opacity' });
        root.classList.remove('gx-lock');
        document.dispatchEvent(new CustomEvent('gx:viewer', { detail: { open: false } }));
        const back = moved
          ? document.querySelectorAll<HTMLElement>('.gxd-item')[at]?.querySelector<HTMLElement>('.gxd-open')
          : lastFocus;
        // (in the rows the page is scrolled to it, and the focus may bring it the rest of the way)
        back?.focus({ preventScroll: walk || !moved });
      };
      // a different photo than the one you opened: the page moves on to it underneath (the walk walks
      // there; the rows scroll it to the middle of the screen)
      if (moved) {
        if (walk) document.dispatchEvent(new CustomEvent('gx:goto', { detail: { i: at } }));
        else document.querySelectorAll<HTMLElement>('.gxd-item')[at]?.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
      }
      if (!anim || !media) { done(); return; }
      const el = media;
      el.querySelector('video')?.pause();
      gsap.to(ui, { opacity: 0, duration: 0.25 });
      gsap.to(veil, { opacity: 0, duration: 0.6, ease: 'power2.inOut', delay: 0.08 });
      requestAnimationFrame(() => {
        const r = sourceOf(at);
        if (r) fly(el, r, true, done);
        else gsap.to(el, { opacity: 0, scale: 0.94, duration: 0.45, ease: 'power2.in', onComplete: done });
      });
    }

    function step(d: number) {
      if (!isOpen || list.length < 2) return;
      const old = media;
      const hadFocus = !!old && old.contains(document.activeElement);
      at = (at + d + list.length) % list.length;
      caption();
      media = make(list[at]);
      stage.append(media);
      warm();
      if (anim && old) {
        gsap.fromTo(media, { x: d * 80, opacity: 0 }, { x: 0, opacity: 1, duration: 0.7, ease: 'expo.out' });
        gsap.to(old, { x: `-=${d * 80}`, opacity: 0, duration: 0.4, ease: 'power2.in', onComplete: () => old.remove() });
      } else old?.remove();
      // the focus was on the film that just left: it moves to the one that came
      if (hadFocus) (player() ?? closeB).focus({ preventScroll: true });
    }

    document.addEventListener('gx:view', (e) => {
      const { list: k, i, from } = (e as CustomEvent<{ list: Kind; i: number; from?: Element }>).detail;
      openAt(k, i, from);
    });
    closeB.addEventListener('click', close);
    prevB.addEventListener('click', () => step(-1));
    nextB.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      // a film with its own controls has the focus: space plays it and the arrows seek, as they should
      const film = player();
      if (film && document.activeElement === film && (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === ' ')) return;
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); close(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      else if (e.key === 'Tab') {
        // focus stays inside the viewer (the film first, when it has controls)
        const f = [film, closeB, prevB, nextB].filter((b): b is HTMLVideoElement | HTMLButtonElement => !!b && !b.hidden);
        const k = f.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        f[(k + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
      }
    }, true);

    // swipe sideways to browse, pull down to close, tap the dark around the picture to close
    let drag: { x: number; y: number; dx: number; dy: number; axis: '' | 'x' | 'y'; t: number; on: boolean } | null = null;
    stage.addEventListener('pointerdown', (e) => {
      if (!media || e.button) return;
      const t = e.target as Element;
      if (t.closest('video[controls]')) return;
      drag = { x: e.clientX, y: e.clientY, dx: 0, dy: 0, axis: '', t: performance.now(), on: !!t.closest('.gxv-media') };
      try { stage.setPointerCapture(e.pointerId); } catch { /* pointer already gone */ }
    });
    stage.addEventListener('pointermove', (e) => {
      if (!drag || !media) return;
      drag.dx = e.clientX - drag.x;
      drag.dy = e.clientY - drag.y;
      if (!drag.axis && Math.hypot(drag.dx, drag.dy) > 10) drag.axis = Math.abs(drag.dx) > Math.abs(drag.dy) ? 'x' : 'y';
      if (!anim) return;
      if (drag.axis === 'x') gsap.set(media, { x: drag.dx });
      if (drag.axis === 'y' && drag.dy > 0) {
        const k = Math.min(1, drag.dy / 420);
        gsap.set(media, { y: drag.dy, scale: 1 - k * 0.16 });
        gsap.set(veil, { opacity: 1 - k * 0.8 });
      }
    });
    const endDrag = () => {
      if (!drag) return;
      const d = drag;
      drag = null;
      if (!media) return;
      const v = Math.abs(d.axis === 'x' ? d.dx : d.dy) / Math.max(1, performance.now() - d.t);
      if (d.axis === 'x' && (Math.abs(d.dx) > 70 || (Math.abs(d.dx) > 24 && v > 0.5))) { step(d.dx < 0 ? 1 : -1); return; }
      if (d.axis === 'y' && (d.dy > 130 || (d.dy > 40 && v > 0.6))) { close(); return; }
      if (anim) {
        gsap.to(media, { x: 0, y: 0, scale: 1, duration: 0.5, ease: 'expo.out' });
        gsap.to(veil, { opacity: 1, duration: 0.4 });
      }
      if (!d.axis && !d.on) close();
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);
    addEventListener('resize', () => { if (isOpen && media) { gsap.set(media, { clearProps: 'transform' }); seat(media, list[at]); } });
  }
</script>
