---
// The booking, as a full-screen page of its own over the site, like the job application (Apply.astro): the same
// page, the same steps, the same buttons (styles/apply.css, and styles/book.css for the little booking adds). The
// client: "rework the booking flow like you did careers". Instead of a trip to the booking page and a form there,
// the booking opens where you are, in three short steps.
//   1. «Что бронируете?»: the kinds, one to a row; a tap chooses one (its seam lights) and moves on.
//   2. «Сколько вас?»: the kind chosen (and the night, when a poster brought you), the guests, the occasion, wishes.
//   3. «Как с вами связаться?»: name, phone, how to reply, the consent.
// Then thanks, with the table's lamp lit; or, if sending fails, the same request again (nothing typed is lost), or
// WhatsApp with the request already in the message.
// One dialog for the whole site (Base.astro). Any link to this language's /booking/ opens it in place, its query as
// presets: ?type= (that kind chosen, and it opens on step 2), ?date=YYYY-MM-DD (a poster's night; not one that has
// been), ?occasion= (preselected). So does anything with data-book (data-book-type, data-book-occasion). It opens
// again where the visitor left off, unless the link brings presets; after a request (sent or not) it starts afresh.
// Arriving at /booking/ itself (a shared link, a new tab) opens it straight away, with that page's query.
// It sends to /api/booking (the managers' Telegram), as the booking form did. Personal data never goes into the URL.
// The final pass (2026-11-22): the picture on the left (a computer's) is the club's photograph of an evening at a
// table, hands in dark suits raising their whisky over the ice bucket, as the job application's is the dressing room
// (the drawn table and lamp that stood there alone read as a placeholder). Its light comes up with the request, a
// step at a time, and is full when the request has gone; the sent step has the table with its lamp, drawn
// (LineArt.astro), lit amber, on every screen.
// The window is the job application's (apply.css); styles/book.css has only what the booking adds.
import LineArt from './LineArt.astro';
import { type Lang, ui, tr } from '../data/i18n';
import { site } from '../data/site';
import { bookingTypes, bookingFine, events, media } from '../data/content';
import { photo } from '../data/images';
import { keepShort } from '../data/format';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ru = lang === 'ru';
const f = ui[lang].form;
// the nights a poster can book: date → name
const nights = Object.fromEntries(events.map((e) => [e.date, tr(e.title, lang)]));
const occasions = Object.entries(f.occasions);
const vias = ['WhatsApp', 'Telegram', f.call];
// The consent's sentence is i18n's; only the policy's own name in it is the link, so a tap on the rest ticks the box
// (were the sentence ever reworded without that name, its last two words would be the link). «18 лет» stays together.
const [, consentA, consentLink, consentB] =
  f.consent.match(/^(.*?)(политику конфиденциальности|the privacy policy)(.*)$/) ?? f.consent.match(/^(.*\s)(\S+\s+\S+)()$/) ?? ['', '', f.consent, ''];
const unit = (t: string) => t.replace(/(\d) (?=\p{L})/gu, '$1\u00a0');
const L = ru
  ? {
      title: 'Бронь', close: 'Закрыть', back: 'Назад', next: 'Дальше',
      h1: 'Что бронируете?',
      h2: 'Сколько вас?', what: 'Бронь', change: 'изменить', night: 'Вечер', fewer: 'Меньше гостей', more: 'Больше гостей',
      wishesPh: 'Например, ложа у сцены или торт в полночь',
      h3: 'Как с вами связаться?', via: 'Как вам ответить',
      doneH: 'Заявка принята', doneText: 'Менеджер перезвонит, обычно в течение 15 минут, и подтвердит бронь. Если вопрос срочный, напишите в WhatsApp.', ok: 'Закрыть',
      needContact: 'Укажите имя и телефон.', needConsent: 'Подтвердите, что вам есть 18 и вы принимаете политику конфиденциальности.',
      hello: 'Здравствуйте. Хочу забронировать в HOTLAND:', guestsWord: 'гостей',
    }
  : {
      title: 'Booking', close: 'Close', back: 'Back', next: 'Next',
      h1: 'What are you booking?',
      h2: 'How many of you?', what: 'Booking', change: 'change', night: 'Night', fewer: 'Fewer guests', more: 'More guests',
      wishesPh: 'For example, a booth by the stage or a cake at midnight',
      h3: 'How do we reach you?', via: 'How should we reply',
      doneH: 'Request received', doneText: 'Your manager will call back, usually within 15 minutes, to confirm. If it’s urgent, message us on WhatsApp.', ok: 'Close',
      needContact: 'Please enter your name and phone number.', needConsent: 'Please confirm you’re 18 or over and accept the privacy policy.',
      hello: 'Hello, I’d like to book at HOTLAND:', guestsWord: 'guests',
    };
// the evening at a table: hands in dark suits, whisky, the ice bucket (a computer's picture; a lazy one: it loads only
// when the window opens there)
const pic = await photo(media('party-2-bachelor.webp'), '(min-width: 900px) 42vw, 1px');
const script = {
  needContact: L.needContact, needConsent: L.needConsent, hello: L.hello, guestsWord: L.guestsWord,
  locale: ru ? 'ru-RU' : 'en-GB', path: `/${lang}/booking/`,
};
---
<dialog class="apl bk" id="book-dlg" aria-labelledby="bk-title" data-lenis-prevent data-wa={site.whatsapp} data-l={JSON.stringify(script)} data-nights={JSON.stringify(nights)}>
  <h2 class="sr-only" id="bk-title">{L.title}</h2>
  <div class="apl-in">
    <figure class="apl-pic bk-pic" aria-hidden="true"><img src={media('party-2-bachelor.webp')} {...pic} alt="" loading="lazy" decoding="async" /></figure>
    <form class="apl-box" novalidate data-step="1">
      <header class="apl-top">
        <p class="apl-count" aria-hidden="true"><b data-bk-n>01</b><span>/&nbsp;03</span></p>
        <button class="apl-x" type="button" data-bk-close aria-label={L.close}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </header>
      <span class="apl-line" aria-hidden="true"><i></i></span>

      <div class="apl-steps">
        <!-- 1: what -->
        <fieldset class="apl-step" data-s="1" aria-labelledby="bk-h1">
          <h3 class="apl-h" id="bk-h1" tabindex="-1">{L.h1}</h3>
          <p class="apl-lead" set:html={keepShort(tr(bookingFine, lang), lang)} />
          <div class="apl-roles">
            {bookingTypes.map((b) => (
              <label><input type="radio" name="type" value={b.id} /><span>{tr(b.label, lang)}</span></label>
            ))}
          </div>
        </fieldset>

        <!-- 2: how many, the occasion, wishes -->
        <fieldset class="apl-step" data-s="2" aria-labelledby="bk-h2" hidden>
          <h3 class="apl-h" id="bk-h2" tabindex="-1">{L.h2}</h3>
          <div class="bk-chosen">
            <p class="apl-chosen">{L.what}: <b data-bk-type></b> <button type="button" class="apl-change" data-bk-goto="1">{L.change}</button></p>
            <p class="apl-chosen" data-bk-night hidden>{L.night}: <b></b></p>
          </div>
          <div class="bk-guests">
            <label class="apl-via-l" for="bk-guests">{f.guests}</label>
            <div class="bk-count">
              <button class="bk-pm" type="button" data-bk-minus aria-controls="bk-guests" aria-label={L.fewer}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 12h12" /></svg>
              </button>
              <input id="bk-guests" name="guests" type="number" inputmode="numeric" enterkeyhint="next" min="1" max="200" step="1" value="2" autocomplete="off" />
              <button class="bk-pm" type="button" data-bk-plus aria-controls="bk-guests" aria-label={L.more}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 6v12M6 12h12" /></svg>
              </button>
            </div>
          </div>
          <div class="apl-via" role="radiogroup" aria-labelledby="bk-occ-l">
            <p class="apl-via-l" id="bk-occ-l">{f.occasion}</p>
            <div class="apl-pills">
              {occasions.map(([k, v]) => (
                <label class="apl-pill"><input type="radio" name="occasion" value={k} checked={k === 'none'} /><span>{v}</span></label>
              ))}
            </div>
          </div>
          <div class="field full"><label for="bk-wishes">{f.wishes}</label><textarea id="bk-wishes" name="wishes" rows="3" maxlength="600" placeholder={L.wishesPh}></textarea></div>
        </fieldset>

        <!-- 3: how to reach you, and the consent -->
        <fieldset class="apl-step" data-s="3" aria-labelledby="bk-h3" hidden>
          <h3 class="apl-h" id="bk-h3" tabindex="-1">{L.h3}</h3>
          <div class="fields apl-fields">
            <div class="field"><label for="bk-name">{f.name}</label><input id="bk-name" name="name" autocomplete="name" required /></div>
            <div class="field"><label for="bk-phone">{f.phone}</label><input id="bk-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required /></div>
          </div>
          <div class="apl-via" role="radiogroup" aria-labelledby="bk-via-l">
            <p class="apl-via-l" id="bk-via-l">{L.via}</p>
            <div class="apl-pills">
              {vias.map((v, i) => (
                <label class="apl-pill"><input type="radio" name="messenger" value={v} checked={i === 0} /><span>{v}</span></label>
              ))}
            </div>
          </div>
          <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
          <label class="consent"><input type="checkbox" name="consent" required /><span>{unit(consentA)}<a href={`/${lang}/privacy/`} target="_blank" rel="noopener">{consentLink}</a>{consentB}</span></label>
        </fieldset>

        <!-- sent: the table with its lamp, lit -->
        <div class="apl-step apl-end" data-s="done" role="status" hidden>
          <div class="bk-done-table" aria-hidden="true"><LineArt name="lamp" class="bk-lamp-done" /></div>
          <p class="apl-h" tabindex="-1">{L.doneH}</p>
          <p class="apl-lead" set:html={keepShort(L.doneText, lang)} />
          <div class="btns">
            <button class="btn btn-crimson" type="button" data-bk-close>{L.ok}</button>
            <a class="btn btn-line" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </div>

        <!-- not sent: the same request again, or WhatsApp with the request in the message -->
        <div class="apl-step apl-end" data-s="fail" role="alert" hidden>
          <p class="apl-h" tabindex="-1">{f.failTitle}</p>
          <p class="apl-lead">{f.failText}</p>
          <div class="btns">
            <button class="btn btn-crimson" type="button" data-bk-retry>{f.retry}</button>
            <a class="btn btn-line" data-bk-wa data-fallback-wa href={site.whatsapp} target="_blank" rel="noopener">{f.sendWa}</a>
            <a class="btn btn-line" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
          </div>
        </div>
      </div>

      <footer class="apl-foot">
        <p class="apl-err" id="bk-err" role="alert" hidden></p>
        <button class="btn btn-line apl-back" type="button" data-bk-back>{L.back}</button>
        <button class="btn btn-crimson apl-next" type="button" data-bk-next>{L.next}</button>
        <button class="btn btn-crimson apl-send" type="submit" data-sending={f.sending} hidden>{f.submit}</button>
      </footer>
    </form>
  </div>
</dialog>

<script>
  import { track } from '../scripts/track';
  const dlg = document.getElementById('book-dlg') as HTMLDialogElement | null;
  if (dlg) {
    const root = document.documentElement;
    const form = dlg.querySelector<HTMLFormElement>('form')!;
    const L = JSON.parse(dlg.dataset.l || '{}') as { needContact: string; needConsent: string; hello: string; guestsWord: string; locale: string; path: string };
    const nights: Record<string, string> = JSON.parse(dlg.dataset.nights || '{}');
    const steps = Array.from(dlg.querySelectorAll<HTMLElement>('[data-s]'));
    const box = dlg.querySelector<HTMLElement>('.apl-steps')!;
    const count = dlg.querySelector<HTMLElement>('[data-bk-n]')!;
    const chosen = dlg.querySelector<HTMLElement>('[data-bk-type]')!;
    const nightLine = dlg.querySelector<HTMLElement>('[data-bk-night]')!;
    const err = dlg.querySelector<HTMLElement>('.apl-err')!;
    const back = dlg.querySelector<HTMLButtonElement>('[data-bk-back]')!;
    const next = dlg.querySelector<HTMLButtonElement>('[data-bk-next]')!;
    const send = dlg.querySelector<HTMLButtonElement>('.apl-send')!;
    const types = Array.from(dlg.querySelectorAll<HTMLInputElement>('input[name="type"]'));
    const occasions = Array.from(dlg.querySelectorAll<HTMLInputElement>('input[name="occasion"]'));
    const guests = dlg.querySelector<HTMLInputElement>('input[name="guests"]')!;
    const minus = dlg.querySelector<HTMLButtonElement>('[data-bk-minus]')!;
    const plus = dlg.querySelector<HTMLButtonElement>('[data-bk-plus]')!;
    const name = dlg.querySelector<HTMLInputElement>('input[name="name"]')!;
    const phone = dlg.querySelector<HTMLInputElement>('input[name="phone"]')!;
    const consent = dlg.querySelector<HTMLInputElement>('input[name="consent"]')!;
    const wa = dlg.querySelector<HTMLAnchorElement>('[data-bk-wa]')!;
    const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    let step = '1';
    let night = '';
    let started = 0; // when this request began (the spam check counts from here, not from the latest opening)
    let auto = 0;
    let over = false; // opened over another full-screen layer of the page's (the artist profile)

    const say = (text = '') => { err.textContent = text; err.hidden = !text; };
    // What can be wrong on the last step, and how each is right. A field that is wrong shows it itself (apply.css:
    // .is-bad, its line in light) and says so to a screen reader; put right, its mark goes, and the message with the
    // last of them.
    const checks: [HTMLInputElement, () => boolean][] = [
      [name, () => Boolean(name.value.trim())],
      [phone, () => phone.value.replace(/\D/g, '').length >= 6],
      [consent, () => consent.checked],
    ];
    function mark(el: HTMLInputElement, bad: boolean) {
      el.closest('.field, .consent')?.classList.toggle('is-bad', bad);
      if (bad) { el.setAttribute('aria-invalid', 'true'); el.setAttribute('aria-describedby', err.id); }
      else { el.removeAttribute('aria-invalid'); el.removeAttribute('aria-describedby'); }
    }
    /** The first of these that is wrong: marked, named at the window's foot, and the cursor in it. */
    function wrong(els: HTMLInputElement[], text: string) {
      const bad = checks.filter(([el, ok]) => els.includes(el) && !ok()).map(([el]) => el);
      els.forEach((el) => mark(el, bad.includes(el)));
      if (!bad.length) return false;
      say(text);
      bad[0].focus();
      return true;
    }
    form.addEventListener('input', () => {
      checks.forEach(([el, ok]) => { if (el.hasAttribute('aria-invalid') && ok()) mark(el, false); });
      if (!form.querySelector('[aria-invalid]')) say();
    });
    /** Show a step: its number above, the line filling, the buttons it needs; the eye (and the keyboard) on its heading. */
    function show(s: string, focus = true) {
      step = s;
      form.dataset.step = s;
      steps.forEach((el) => { el.hidden = el.dataset.s !== s; });
      const ending = s === 'done' || s === 'fail';
      const n = Number(s) || 3;
      count.textContent = `0${n}`;
      dlg!.style.setProperty('--apl-p', String(ending ? 1 : n / 3));
      back.hidden = s === '1' || ending;
      next.hidden = s !== '2';
      send.hidden = s !== '3';
      form.classList.toggle('apl-ending', ending);
      checks.forEach(([el]) => mark(el, false));
      say();
      box.scrollTop = 0;
      if (focus) dlg!.querySelector<HTMLElement>(`[data-s="${s}"] .apl-h`)?.focus({ preventScroll: true });
    }

    const labelOf = (input?: HTMLInputElement) => input?.closest('label')?.textContent?.trim() || '';
    const type = () => types.find((r) => r.checked);

    // the night, as a poster names it: «Courchevel, пятница, 13 ноября» (or only the date, for a night without a poster)
    const today = () => {
      const t = new Date();
      return `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, '0')}-${String(t.getDate()).padStart(2, '0')}`;
    };
    /** A real date, today or later; anything else is no night at all. */
    function dayOf(v?: string | null) {
      if (!v || !/^\d{4}-\d{2}-\d{2}$/.test(v)) return '';
      const [y, m, d] = v.split('-').map(Number);
      const date = new Date(y, m - 1, d);
      if (date.getMonth() !== m - 1 || date.getDate() !== d) return '';
      return v >= today() ? v : '';
    }
    function setNight(day = '') {
      night = '';
      if (day) {
        const [y, m, d] = day.split('-').map(Number);
        const when = new Intl.DateTimeFormat(L.locale, { weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(y, m - 1, d));
        night = [nights[day], when].filter(Boolean).join(', ');
      }
      nightLine.querySelector('b')!.textContent = night;
      nightLine.hidden = !night;
    }

    // the guests: a minus, the number, a plus, from 1 to 200; a number typed in is held to that too
    const MIN = 1;
    const MAX = 200;
    function syncGuests() {
      const n = Number.parseInt(guests.value, 10);
      minus.setAttribute('aria-disabled', String(!(n > MIN)));
      plus.setAttribute('aria-disabled', String(!(n < MAX)));
    }
    function setGuests(n: number) {
      guests.value = String(Number.isFinite(n) ? Math.min(MAX, Math.max(MIN, Math.round(n))) : 2);
      syncGuests();
    }
    const guestsNow = () => Number.parseInt(guests.value, 10) || 2;
    minus.addEventListener('click', () => setGuests(guestsNow() - 1));
    plus.addEventListener('click', () => setGuests(guestsNow() + 1));
    guests.addEventListener('input', syncGuests);
    guests.addEventListener('change', () => setGuests(Number.parseInt(guests.value, 10)));
    syncGuests();

    type Preset = { type?: string; day?: string; occasion?: string };
    /** What a link (or a data-book button) asks for: only a kind, a night and an occasion the dialog knows. */
    function presetOf(t?: string | null, date?: string | null, occasion?: string | null): Preset | null {
      const p: Preset = {};
      if (t && types.some((r) => r.value === t)) p.type = t;
      const day = dayOf(date);
      if (day) p.day = day;
      if (occasion && occasions.some((r) => r.value === occasion)) p.occasion = occasion;
      return p.type || p.day || p.occasion ? p : null;
    }

    /** Open it: afresh after a request went out (or failed to); with a link's kind, night and occasion when it brings
     *  them (on step 2 when the kind is among them), keeping what the visitor has typed; otherwise where the visitor
     *  left off (or on step 1). `layer`: it opens over another full-screen layer of the page's. */
    function open(p: Preset | null, layer = false) {
      if (dlg!.open) return;
      over = layer;
      if (step === 'done' || step === 'fail') {
        form.reset();
        setNight();
        syncGuests();
        started = 0;
        step = '1';
      }
      if (p) {
        types.forEach((r) => { r.checked = r.value === p.type; });
        setNight(p.day);
        const o = occasions.find((r) => r.value === (p.occasion || 'none'));
        if (o) o.checked = true;
        step = p.type ? '2' : '1';
      }
      chosen.textContent = labelOf(type());
      if (!type()) step = '1';
      root.classList.add('bk-lock');
      if (typeof dlg!.showModal === 'function') dlg!.showModal();
      else dlg!.setAttribute('open', '');
      if (!started) started = Date.now();
      show(step);
      track('booking_open');
    }
    /** Close it: the window leaves in a short fade (apply.css: apl-out), and only then closes, so the page is never
     *  cut to. (The timer is for a browser that never says the fade has ended.) */
    function close() {
      if (!dlg!.open || dlg!.classList.contains('apl-out')) return;
      let closed = false;
      const end = (e?: Event) => {
        if (closed || (e && e.target !== dlg)) return; // (a step's own entrance ending inside is not the window's)
        closed = true;
        dlg!.removeEventListener('animationend', end);
        dlg!.classList.remove('apl-out');
        if (typeof dlg!.close === 'function') dlg!.close();
        else dlg!.removeAttribute('open');
        root.classList.remove('bk-lock');
      };
      dlg!.addEventListener('animationend', end);
      dlg!.classList.add('apl-out');
      setTimeout(end, 400);
    }
    dlg.addEventListener('close', () => root.classList.remove('bk-lock'));
    // Esc: the same closing as the cross
    dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dlg.querySelectorAll<HTMLElement>('[data-bk-close]').forEach((b) => b.addEventListener('click', close));

    // Any link to this language's booking page, or anything with data-book, opens it where you are (a new tab or
    // window, or a link another script has already taken, still goes its own way). The phone menu, if the link was
    // in it, closes behind the dialog.
    document.addEventListener('click', (e) => {
      const m = e as MouseEvent;
      if (m.defaultPrevented || m.button || m.metaKey || m.ctrlKey || m.shiftKey || m.altKey) return;
      const at = e.target as Element | null;
      const b = at?.closest?.('[data-book]') as HTMLElement | null | undefined;
      let p: Preset | null = null;
      if (b) p = presetOf(b.dataset.bookType, null, b.dataset.bookOccasion);
      else {
        const a = at?.closest?.('a[href]') as HTMLAnchorElement | null | undefined;
        if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;
        let url: URL;
        try { url = new URL(a.href, location.href); } catch { return; }
        if (url.origin !== location.origin || url.pathname !== L.path) return;
        p = presetOf(url.searchParams.get('type'), url.searchParams.get('date'), url.searchParams.get('occasion'));
      }
      e.preventDefault();
      const menu = document.getElementById('mnav');
      if (menu && !menu.hidden && menu.contains(at)) menu.querySelector<HTMLElement>('[data-close]')?.click();
      const layer = at?.closest?.('[aria-modal="true"]');
      open(p, Boolean(layer && layer !== menu));
    });

    // Opened over another of the page's own full-screen layers (the artist profile), the keys are the dialog's alone
    // while it is open: what that layer does with them (its arrows, Tab and Esc) waits until the dialog closes. Enter
    // on step 1 chooses, on step 2 goes on to step 3 (not to sending); on step 3 it sends, which checks the fields first.
    addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (over) e.stopPropagation();
      if (e.key !== 'Enter' || e.isComposing) return;
      const el = e.target as HTMLInputElement;
      if (el.tagName !== 'INPUT' || !dlg.contains(el)) return;
      if (step === '1' && el.name === 'type') { e.preventDefault(); el.checked = true; pick(el); }
      else if (step === '2') { e.preventDefault(); toThree(); }
    }, true);

    // step 1: a tap on a kind chooses it and moves on (a moment later, so the choice is seen); a tap on the kind
    // already chosen moves on too
    function pick(r: HTMLInputElement) {
      chosen.textContent = labelOf(r);
      clearTimeout(auto);
      auto = window.setTimeout(() => { if (step === '1' && dlg!.open) show('2'); }, still() ? 0 : 280);
    }
    types.forEach((r) => {
      r.addEventListener('change', () => pick(r));
      r.addEventListener('click', () => { if (r.checked) pick(r); });
    });
    dlg.querySelector('[data-bk-goto="1"]')?.addEventListener('click', () => show('1'));
    back.addEventListener('click', () => show(step === '3' ? '2' : '1'));
    function toThree() {
      setGuests(Number.parseInt(guests.value, 10));
      show('3');
    }
    next.addEventListener('click', toThree);

    // Everything the managers need (the booking form's request, word for word), and the same as a message.
    function collect() {
      const fd = new FormData(form);
      const v = (k: string) => String(fd.get(k) || '').trim();
      const t = type();
      const o = occasions.find((r) => r.checked);
      return {
        type: t?.value || '', typeLabel: labelOf(t), night, guests: v('guests'),
        occasion: o?.value || '', occasionLabel: labelOf(o),
        name: v('name'), phone: v('phone'), messenger: v('messenger'), wishes: v('wishes'), website: v('website'),
      };
    }
    const asMessage = (d: ReturnType<typeof collect>) => [
      L.hello,
      [d.typeLabel, d.night, `${L.guestsWord}: ${d.guests}`].filter(Boolean).join(', '),
      d.occasion && d.occasion !== 'none' ? d.occasionLabel : '',
      `${d.name}, ${d.phone}`,
      d.wishes,
    ].filter(Boolean).join('\n');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (step === '2') { toThree(); return; }
      if (step !== '3' || send.disabled) return;
      if (!type()) { show('1'); return; }
      if (wrong([name, phone], L.needContact) || wrong([consent], L.needConsent)) return;
      say();
      setGuests(Number.parseInt(guests.value, 10));
      const data = collect();
      const label = send.textContent || '';
      send.disabled = true;
      send.textContent = send.dataset.sending || '…';
      try {
        const r = await fetch('/api/booking', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ ...data, elapsed: Date.now() - started, lang: root.lang, page: location.pathname }),
          signal: typeof AbortSignal.timeout === 'function' ? AbortSignal.timeout(12000) : undefined,
        });
        const res = await r.json().catch(() => ({}));
        if (!(r.ok && res.ok)) throw new Error(res.error || String(r.status));
        track('booking_sent');
        show('done');
      } catch {
        track('booking_failed');
        // hand the same request to WhatsApp, so the visitor doesn't lose what they typed
        wa.href = `${dlg.dataset.wa}?text=${encodeURIComponent(asMessage(data))}`;
        show('fail');
      } finally {
        send.disabled = false;
        send.textContent = label;
      }
    });
    wa.addEventListener('click', () => track('booking_whatsapp'));
    // the same request again: back on its last step, everything still filled in, and sent
    dlg.querySelector('[data-bk-retry]')?.addEventListener('click', () => {
      show('3', false);
      if (typeof form.requestSubmit === 'function') form.requestSubmit(); else send.click();
    });

    // (its picture is a lazy one: a computer fetches it the first time the window opens, a phone never)

    // arriving at the booking page itself (a shared link, a new tab): it opens straight away, with that page's query,
    // once the 18+ question is answered
    if (location.pathname === L.path) {
      const q = new URLSearchParams(location.search);
      const go = () => open(presetOf(q.get('type'), q.get('date'), q.get('occasion')));
      const gate = document.getElementById('gate');
      if (!gate || root.classList.contains('age-ok') || gate.classList.contains('out')) go();
      else addEventListener('hotland:gate', go, { once: true });
    }
  }
</script>
