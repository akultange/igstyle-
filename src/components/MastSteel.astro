---
// Gio's footer sign (data/variants.ts, 'footer'): the HOTLAND masthead set edge to edge in steel, in the same face as
// the home hero's name (Noto Sans Display Black at its narrowest width, as outlines from data/wordmark.ts): polished
// chrome tones (top light, a soft warm band, a bright return) laid over a brushed-metal grain, clipped to the
// letters. Every few seconds a band of light crosses the letters (off for reduced motion). Luka's 3D sign is Mast.astro.
// Purely decorative (aria-hidden); pages put the readable name in an sr-only heading.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
import { line, lineBox } from '../data/wordmark';
const id = 'mh' + Math.random().toString(36).slice(2, 8);
const word = line('HOTLAND');
const W = word.width;
const d = word.paths.join('');
---
<svg class:list={['mast', 'mast-steel', cls]} viewBox={lineBox(W)} aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  <defs>
    <linearGradient id={`${id}-s`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".95" />
      <stop offset=".26" stop-color="#ffffff" stop-opacity=".55" />
      <stop offset=".46" stop-color="#28221e" stop-opacity=".22" />
      <stop offset=".52" stop-color="#1e1a16" stop-opacity=".4" />
      <stop offset=".63" stop-color="#ffffff" stop-opacity=".72" />
      <stop offset=".8" stop-color="#ffffff" stop-opacity=".36" />
      <stop offset="1" stop-color="#28221e" stop-opacity=".26" />
    </linearGradient>
    <pattern id={`${id}-p`} patternUnits="userSpaceOnUse" x="0" y="-725" width={W} height="735">
      <rect width={W} height="735" fill="#c4c6ca" />
      <image href="/img/metal/brushed.webp" width={W} height="735" preserveAspectRatio="none" />
      <rect width={W} height="735" fill={`url(#${id}-s)`} />
    </pattern>
    <clipPath id={`${id}-c`}><path d={d} /></clipPath>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0" />
      <stop offset=".5" stop-color="#fff" stop-opacity=".8" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
  </defs>
  <path class="mast-t" d={d} fill={`url(#${id}-p)`} stroke="rgba(255,255,255,.28)" stroke-width="2" />
  <g clip-path={`url(#${id}-c)`}>
    <g transform="skewX(-24)"><rect class="mast-glint" x="-900" y="-800" width="560" height="900" fill={`url(#${id}-g)`} /></g>
  </g>
</svg>

<style is:global>
  /* in the footer's sign box (global.css .ft-mast): as wide as the box allows, at the word's own proportions */
  .ft-mast .mast-steel { width: min(100cqw, (100cqh - 2 * var(--gap-y)) * 5.015); }
  .mast-steel .mast-glint { animation: mast-steel-glint 9s var(--ease-io) 3s infinite; }
  @keyframes mast-steel-glint { 0% { transform: translateX(0); } 15%, 100% { transform: translateX(5200px); } }
  @media (prefers-reduced-motion: reduce) { .mast-steel .mast-glint { animation: none; } }
</style>
