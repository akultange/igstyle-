---
// An occasion's page (birthday, bachelor, corporate, the whole club). Under the title, the occasion's own photograph
// as a band; then what comes with a party, beside the occasion's picture (content.ts, `scene`); the club's three cards;
// three more photographs; and the request. Every picture is the club's own photograph, torn from the newspaper like
// every picture on the site (Photo.astro, cut.css). The line art stays an accent: the occasion's drawing in chalk,
// small, under the request's words (the glass for a birthday's toast, the cigar for the groom's night, the bottle for
// the company's table, the door for the whole club, shut to everyone else that night).
import Base from '../../../layouts/Base.astro';
import Photo from '../../../components/Photo.astro';
import PageTitle from '../../../components/PageTitle.astro';
import MemberCards from '../../../components/MemberCards.astro';
import LineArt from '../../../components/LineArt.astro';
import { type LineArtName } from '../../../data/lineart';
import { type Lang, ui, tr, langs } from '../../../data/i18n';
import { site } from '../../../data/site';
import { occasions, parties, vip, bookingFine, media, type Occasion } from '../../../data/content';

export function getStaticPaths() {
  return langs.flatMap((lang) => occasions.map((o) => ({ params: { lang, occasion: o.slug }, props: { o } })));
}
const lang = Astro.params.lang as Lang;
const { o } = Astro.props as { o: Occasion };
const t = ui[lang];
const ru = lang === 'ru';
const title = tr(o.title, lang);
// the three more pictures: 4:3, 1:1 and 3:4, side by side at one height (global.css, .trio)
const ratios = ['4/3', '1/1', '3/4'];
// Russian typesetting: a short word stays on the line of the word after it ("за каждый", "без счёта"), and a
// hyphenated word never breaks at its hyphen ("шоу-программа").
const keep = (s: string) => (ru ? s.replace(/(?<=^|\s)(в|во|на|за|до|по|под|с|со|к|ко|и|а|о|у|не|ни|от|из|для|без)\s/gi, '$1\u00a0') : s).replace(/(\S)-(?=\S)/g, '$1\u2011');
// The request is the booking dialog (Book.astro), opened by a link to the booking page with a party and this
// occasion chosen, so it starts on its second step (a new tab opens the booking page with the same choice). Beside
// the request's words, its three steps, the first already done.
const occasion = (t.form.occasions as Record<string, string>)[o.slug];
const bookHref = `/${lang}/booking/?type=event${occasion ? `&occasion=${o.slug}` : ''}`;
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const art: Record<Occasion['slug'], LineArtName> = { birthday: 'glass', bachelor: 'cigar', corporate: 'bottle', hire: 'door' };
const requestSteps = [
  `${ru ? 'Праздник' : 'A party'}: ${lower(occasion ?? title)}`,
  ru ? 'Сколько гостей и ваши пожелания' : 'How many guests, and your wishes',
  ru ? 'Как с вами связаться' : 'How to reach you',
];
---
<Base lang={lang} title={title} description={tr(o.text, lang)} waContext={title} closing={false}>
  <PageTitle
    crumbs={[{ href: `/${lang}/`, label: 'HOTLAND' }, { href: `/${lang}/membership/`, label: t.nav.vip }, { label: title }]}
    title={title}
    lead={tr(o.text, lang)}
    img={media(o.img)}
    imgAlt={tr(o.alt, lang)}
    band
  >
    <a class="btn btn-crimson" href={bookHref}>{tr(parties.cta, lang)}</a>
  </PageTitle>

  <!-- 01 What comes with a party: the heading and the four rows on the left; the occasion's photograph on the right,
       its top level with the heading's -->
  <section class="sec" aria-labelledby="occ-in-h">
    <div class="wrap">
      <div class="g12">
        <div class="occ-words">
          <h2 class="t-l" id="occ-in-h" set:html={ru ? 'Что входит <em>в&nbsp;праздник</em>' : 'What’s <em>included</em>'} />
          <div class="rows">
            {parties.included.map((x, i) => <div class="row num"><span class="n">0{i + 1}</span><span class="k">{keep(tr(x, lang))}</span><span></span></div>)}
          </div>
        </div>
        <div class="occ-pic">
          <Photo src={media(o.scene.img)} alt={tr(o.scene.alt, lang)} ratio="4/3" pos={o.scene.pos} />
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Membership: the three cards as on the home page, with the heading row (title, note and the link to the
       membership page) inside the field -->
  <section class="sec">
    <div class="wrap">
      <MemberCards lang={lang}>
        <div slot="head" class="bighead bh-line">
          <h2 class="t-l" set:html={tr(vip.title, lang)} />
          <div class="bighead-side">
            <p class="body">{keep(tr(vip.lead, lang))}</p>
            <a class="lnk" href={`/${lang}/membership/`}>{t.nav.vip}</a>
          </div>
        </div>
      </MemberCards>
    </div>
  </section>

  <!-- 03 Three more photographs of such a night, side by side at one height -->
  <section class="sec-t">
    <div class="wrap trio">
      {o.more.map((f, i) => <Photo src={media(f.img)} alt={tr(f.alt, lang)} ratio={ratios[i]} pos={f.pos} />)}
    </div>
  </section>

  <!-- 04 Request: the words, and under them the occasion's drawing; the three steps with the main button; the
       messengers. On a wide screen the words and the messengers stand on the left and the steps on the right; on a
       phone they come in that order, so the steps and the main button are met before the messengers. The first step
       is the one you are on. -->
  <section class="sec soot" id="request" aria-labelledby="rq-h">
    <div class="wrap">
      <div class="g12">
        <div class="stack rq-words">
          <h2 class="t-l" id="rq-h" set:html={ru ? 'Заявка <em>на&nbsp;праздник</em>' : 'Request <em>a party</em>'} />
          <p class="body">{tr(bookingFine, lang)}</p>
          <LineArt name={art[o.slug]} class={`rq-art rq-art-${art[o.slug]}`} />
        </div>
        <div class="stack rq-steps">
          <div class="rows">
            {requestSteps.map((s, i) => <div class="row num" aria-current={i === 0 ? 'step' : undefined}><span class="n">0{i + 1}</span><span class="k">{keep(s)}</span><span></span></div>)}
          </div>
          <div class="btns"><a class="btn btn-crimson" href={bookHref}>{tr(parties.cta, lang)}</a></div>
        </div>
        <div class="btns rq-msg">
          <a class="btn btn-line btn-sm" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
          <a class="btn btn-line btn-sm" href={site.telegram} target="_blank" rel="noopener">Telegram</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* What comes with a party: the heading and the four rows under it on the left; the occasion's photograph on the
     right (4:3, torn like every picture: cut.css), its top level with the heading's. One column (the same screens as
     every .g12, global.css): the heading, the rows, then the photograph. */
  .occ-words { grid-column: 1 / span 5; display: grid; align-content: start; gap: var(--head-gap); }
  .occ-words .rows { text-wrap: pretty; }
  .occ-pic { grid-column: 7 / span 6; align-self: start; }
  /* The request block. A wide screen: the words and, under them, the messengers on the left; the steps and the main
     button on the right, beside both. One column (the same screens as every .g12, global.css): the words, the
     steps and the main button, then the messengers. */
  .rq-words { grid-column: 1 / span 4; }
  .rq-steps { grid-column: 6 / span 7; grid-row: 1 / span 2; }
  .rq-msg { grid-column: 1 / span 4; grid-row: 2; align-self: start; margin-top: 24px; }
  /* the occasion's drawing, an accent under the words: small, in chalk on the concrete, no frame; each sized by its own
     shape, so the four stand at about one weight (the bottle is tall, the cigar mostly smoke, the door a piece of wall) */
  .rq-words :global(.rq-art) { width: clamp(104px, 9.4vw, 136px); margin: 8px 0 0 -6px; }
  .rq-words :global(.rq-art-cigar) { width: clamp(136px, 12vw, 176px); }
  .rq-words :global(.rq-art-bottle) { width: clamp(64px, 5.6vw, 84px); margin-left: 0; }
  .rq-words :global(.rq-art-door) { width: clamp(160px, 14vw, 216px); margin-left: 0; }
  @media (max-width: 639px), (max-width: 899px) and (orientation: portrait), (max-width: 899px) and (min-height: 501px) {
    .rq-steps, .rq-msg { grid-row: auto; }
    .rq-msg { margin-top: 0; }
    /* (a phone: the steps and the main button come straight after the words; the drawing waits for a wider screen) */
    .rq-words :global(.rq-art) { display: none; }
  }
  /* the step you are on: shirt white over a line of the light along its rule (red; amber after four), as a chosen
     thing is marked everywhere on the site; the two to come are quieter */
  .rq-steps .row { position: relative; }
  .rq-steps .row[aria-current]::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: var(--seam);
    background: var(--lit-core); box-shadow: var(--seam-glow);
  }
  .rq-steps .row:not([aria-current]) .k { color: var(--fg-2); }
  .rq-steps .row:not([aria-current]) .n { color: var(--muted); }
</style>
