---
// After a booking (the booking form's own page; the dialog says the same in its last step, Book.astro): the table
// with its lamp, lit amber, as a booked table is at any hour, standing on its floor line; the two words; what happens
// next; where to go from here. The same table stands on the booking page with its lamp out (booking/index.astro).
// The drawing is the line art (LineArt.astro): with motion it draws itself in and the lamp comes on last; without,
// it is simply lit.
import Base from '../../../layouts/Base.astro';
import LineArt from '../../../components/LineArt.astro';
import { type Lang, langPaths } from '../../../data/i18n';
import { site } from '../../../data/site';
import { keepShort } from '../../../data/format';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const ru = lang === 'ru';
// (the guest has just booked: the page ends with the thanks, without the closing «Ваш стол уже ждёт» and another
// booking button under it)
---
<Base lang={lang} title={ru ? 'Заявка принята' : 'Request received'} description={ru ? 'Заявка на бронь у менеджера: он перезвонит и подтвердит её.' : 'Your booking request is with your manager, who will call back to confirm it.'} noindex closing={false}>
  <section class="thanks thanks-sent">
    <div class="wrap stack center">
      <div class="thanks-table" aria-hidden="true"><LineArt name="lamp" class="thanks-lamp" /></div>
      <h1 class="t-xl" set:html={ru ? 'Заявка <em>принята</em>' : 'Request <em>received</em>'} />
      <p class="lead" set:html={keepShort(ru ? 'Менеджер перезвонит, обычно в течение 15 минут, и подтвердит бронь. Если вопрос срочный, напишите в WhatsApp.' : 'Your manager will call back, usually within 15 minutes, to confirm. If it’s urgent, message us on WhatsApp.', lang)} />
      <div class="btns">
        <a class="btn btn-crimson" href={`/${lang}/program/`}>{ru ? 'Афиша' : 'Events'}</a>
        <a class="btn btn-line" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <a class="btn btn-line" href={`/${lang}/`}>{ru ? 'На главную' : 'Home'}</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* The moment after a booking: the table with its lamp lit, the two words, what happens next and where to go from
     here, one under another on the page's middle line. (The 404 is set the same way: pages/404.astro.) */
  .thanks-sent { overflow-x: clip; }
  .thanks-sent .stack { gap: clamp(20px, 2vw, 28px); }
  /* the table, a size that leaves the words and the first button on the first screen; the lamp lit (the drawing's
     own light, at full: a booked table is amber at any hour). It stands on the floor: a fine line just under its
     shadow (its foot is 447 of the drawing's 500, the shadow ends at 457), fading out either side, as the window's
     floor runs across its panel (book.css). */
  .thanks-sent .thanks-table { position: relative; width: min(64vw, 34vh, 300px); margin-bottom: clamp(0px, 1vw, 8px); }
  .thanks-sent .thanks-table::after {
    content: ''; position: absolute; left: -45%; right: -45%; top: 93.5%; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, var(--rule-2) 32%, var(--rule-2) 68%, transparent);
  }
  .thanks-sent .thanks-lamp { width: 100%; }
  /* (a phone: a shorter floor, clear of the screen's edges, so it never reads as a rule across the page) */
  @media (max-width: 599px) { .thanks-sent .thanks-table::after { left: -18%; right: -18%; } }
  .thanks-sent .t-xl { text-wrap: balance; }
  /* (the lead's lines even, so the last is never a word or two) */
  .thanks-sent .lead { text-wrap: balance; }
  /* the three ways on: a phone gets one column of plates of one width, a wider screen one row (never one plate
     over two, as the row wrapped by itself) */
  .thanks-sent .btns { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; width: min(100%, 320px); margin-top: 8px; }
  @media (min-width: 600px) {
    .thanks-sent .btns { display: flex; flex-wrap: nowrap; justify-content: center; gap: 14px; width: auto; }
  }
  /* phones: the block starts a little higher, so the first plate is on the first screen of the smallest phone */
  @media (max-width: 599px) { .thanks-sent { padding-top: calc(var(--hdr) + 40px); } }
</style>
